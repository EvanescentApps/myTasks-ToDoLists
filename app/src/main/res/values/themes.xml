<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Todolist" parent="Theme.MaterialComponents.Light">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/textContent</item>
        <item name="colorAccent">@color/textContent</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/textContent</item>
        <item name="labelStyle">@color/iconTint</item>
        <item name="android:textColorPrimary">@color/textContent</item>
        <item name="android:textColorSecondary">@color/textContent</item>
        <item name="android:colorForeground">@color/textContent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="fontFamily">@font/lexend_semibold</item>

        <item name="font">@font/lexend_semibold</item>
       <!-- <item name="android:fontFamily">@font/lexend</item>-->
        <!--<item name="fontWeight">600</item>-->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="Theme.Todolist.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent
        </item>
        <item name="android:windowTranslucentStatus" tools:targetApi="kitkat">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.Todolist.AppBarOverlay" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColor">@color/titleLabel</item>
        <item name="android:textColorPrimary">@color/titleLabel</item>
    </style>

    <style name="Theme.Todolist.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/textContent</item>
        <item name="android:textColorSecondary">@color/textContent</item>
        <item name="android:colorForeground">@color/textContent</item>
        <item name="android:textColor">@color/textContent</item>
    </style>

    <style name="checkbox" parent="Theme.Todolist">
        <item name="colorAccent">@color/checkbox</item>
        <item name="checkedIconTint">#740000</item>
    </style>
</resources>
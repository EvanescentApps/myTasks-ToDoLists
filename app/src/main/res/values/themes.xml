<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Todolist" parent="Theme.MaterialComponents.Light">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/textContent</item>
        <item name="colorAccent">@color/textContent</item>
        <item name="colorSecondary">@color/textContentPrimary</item>
        <item name="colorSecondaryVariant">@color/textContentPrimary</item>
        <item name="colorOnSecondary">@color/textContent</item>
        <item name="labelStyle">@color/iconTint</item>

        <item name="android:textColorPrimary">@color/textContent</item>
        <item name="android:textColorSecondary">@color/textContent</item>
        <item name="android:colorForeground">@color/textContent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="fontFamily">@font/lexend_semibold</item>
        <item name="backgroundColor">@color/background</item>
        <item name="font">@font/lexend_semibold</item>
        <item name="android:textColor">@color/textContent</item>

        <!-- <item name="android:fontFamily">@font/lexend</item>-->
        <!--<item name="fontWeight">600</item>-->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="fullscreenBackgroundColor">@color/flowBackground</item>
        <item name="fullscreenTextColor">@color/textContent</item>

        <item name="colorOnSurface">@color/textContent</item>
        <item name="buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/positiveButtonStyle</item>

        <item name="android:navigationBarColor">@color/colorPrimary</item>


        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="positiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">

        <item name="android:textColor">@color/textContent</item>
        <item name="android:solidColor">#E65100</item>
        <item name="background">?attr/selectableItemBackground</item>
        <item name="colorAccent">#652400</item>
    </style>

    <style name="Theme.Todolist.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent
        </item>
        <item name="android:windowTranslucentStatus" tools:targetApi="kitkat">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.Todolist.AppBarOverlay" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColor">@color/titleLabel</item>
        <item name="android:textColorPrimary">@color/titleLabel</item>
    </style>

    <style name="Theme.Todolist.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/textContent</item>
        <item name="android:textColorSecondary">@color/textContent</item>
        <item name="android:colorForeground">@color/textContent</item>
        <item name="android:textColor">@color/textContent</item>
    </style>

    <style name="checkbox" parent="Theme.MaterialComponents.DayNight">
        <item name="colorAccent">@color/checkbox</item>
        <item name="android:textColorSecondary">@color/checkbox</item>
        <item name="checkedIconTint">@color/checkbox</item>
    </style>

    <!-- ALTERNATIVE THEMES -->

    <style name="Theme.Todolist.Fullscreen" parent="Theme.Todolist">
        <item name="android:actionBarStyle">@style/Widget.Theme.Todolist.ActionBar.Fullscreen</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.Todolist.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/flowBackground</item>
        <item name="fullscreenTextColor">@color/textContentSecondary</item>
    </style>

    <style name="AlertDialogCustom" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="backgroundColor">@color/background</item>
        <item name="android:textColor">@color/lightPurple</item>
        <item name="background">@color/background</item>

        <item name="android:background">@color/background</item>

    </style>

    <style name="MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="backgroundColor">@color/background</item>
        <item name="android:textColor">@color/textContent</item>
        <item name="background">@color/background</item>
        <item name="android:background">@color/background</item>
        <item name="colorOnSurface">@color/textContent</item>
        <item name="colorControlNormal">@color/textContentSecondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/positiveButtonStyle</item>
        <!--<item name="android:buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>-->
        <item name="buttonBarButtonStyle">@style/positiveButtonStyle</item>
        <item name="android:buttonBarButtonStyle">@style/positiveButtonStyle</item>
    </style>

    <style name="MaterialAlertDialog_rounded" parent="MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="dialogCornerRadius">22dp</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="MaterialTimePicker" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorControlNormal">@color/background</item>
        <item name="colorControlActivated">@color/textContentPrimary</item>
        <item name="textColorAlertDialogListItem">@color/textContentPrimary</item>
        <item name="colorAccent">@color/textContent</item>
        <item name="android:textColorPrimary">@color/textContentPrimary</item>
        <item name="iconTint">@color/iconTint</item>
        <item name="buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/positiveButtonStyle</item>
        <!--<item name="android:buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>-->
        <item name="buttonBarButtonStyle">@style/positiveButtonStyle</item>
        <item name="android:buttonBarButtonStyle">@style/positiveButtonStyle</item>
    </style>

    <style name="MyDialogTheme" parent="MaterialTimePicker">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="dialogCornerRadius">22dp</item>
    </style>

</resources>
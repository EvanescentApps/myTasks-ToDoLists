<resources>

    <style name="Widget.Theme.Todolist.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.Todolist.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:fontFamily">@font/lexend_bold</item>
    </style>

    <style name="ToolbarTheme" parent="AppTheme.AppBarOverlay">
        <item name="android:fontFamily">@font/lexend_bold</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily">@font/lexend_semibold</item>
    </style>

    <style name="StyledButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginRight">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/textContent
        </item>    <!--	<item name="background">@drawable/pop_bg</item> -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="shapeAppearance">@style/RoundedButtonShapeAppearance</item>
    </style>


    <style name="RoundedButtonShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerRadius">16dp</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
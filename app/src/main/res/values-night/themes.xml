<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Theme.Todolist" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/purpleDark</item>
        <item name="colorPrimaryVariant">@color/purpleDark</item>
        <item name="colorOnPrimary">@color/purpleDark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/textContentPrimary</item>
        <item name="colorSecondaryVariant">@color/textContentPrimary</item>
        <item name="backgroundColor">@color/background</item>
        <item name="colorOnSecondary">@color/pureBlack</item>
        <!-- Status bar color. -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="fontFamily">@font/lexend_semibold</item>
        <item name="android:textColorPrimary">@color/textContent</item>
        <item name="android:textColorSecondary">@color/textContent</item>
        <item name="font">@font/lexend_semibold</item>
        <item name="android:fontFamily">@font/lexend_semibold</item>
        <item name="android:textColor">@color/textContent</item>

        <item name="colorAccent">@color/textContent</item>
        <item name="labelStyle">@color/iconTint</item>

        <item name="android:colorForeground">@color/textContent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- <item name="android:fontFamily">@font/lexend</item>-->
        <!--<item name="fontWeight">600</item>-->
        <item name="fullscreenBackgroundColor">@color/flowBackground</item>
        <item name="fullscreenTextColor">@color/textContent</item>

        <item name="colorOnSurface">@color/textContent</item>
        <item name="buttonBarPositiveButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/positiveButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/positiveButtonStyle</item>

        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ThemeOverlay.Todolist.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/background</item>
        <item name="fullscreenTextColor">@color/textContentSecondary</item>
    </style>
</resources>
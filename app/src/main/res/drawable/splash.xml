<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
<item android:drawable="@color/background"/><!--"@color/colorSplash"-->

    <item
        android:left="120dp"
        android:right="120dp"
        android:bottom="50dp"
        android:gravity="fill">
        <bitmap
            android:layout_height="match_parent"
            android:gravity="center"
            android:left="120dp"
            android:alpha="0.9"
            android:right="120dp"
            android:src="@drawable/rounded_app_icon" />
    </item>


    <item
        android:left="100dp"
        android:right="100dp"
        android:bottom="8dp"
        android:gravity="fill">
        <bitmap
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:left="100dp"
            android:alpha="0.9"
            android:right="100dp"
            android:src="@drawable/version_alpha" />
    </item>

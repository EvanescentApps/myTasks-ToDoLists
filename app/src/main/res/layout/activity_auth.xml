        <Button
            android:id="@+id/with_google"
            style="@style/StyledButton"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:backgroundTint="@color/floatingAddButton"
            android:drawableLeft="@drawable/ic_google_ico_variant1"
            android:drawablePadding="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/google_signin"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/with_mail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="RtlHardcoded,RtlSymmetry" />

        <Button
            android:id="@+id/with_mail"
            style="@style/StyledButton"
            android:layout_height="54dp"
            android:layout_centerInParent="true"
            android:alpha="0.8"
            android:backgroundTint="@color/floatingAddButton"
            android:drawableLeft="@drawable/ic_email_black_24dp"
            android:drawablePadding="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/email_signin"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:backgroundTint="@color/floatingAddButton"
            app:layout_constraintBottom_toTopOf="@id/no_connexion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="RtlHardcoded,RtlSymmetry" />

        <!--<Button
            android:id="@+id/connexion"

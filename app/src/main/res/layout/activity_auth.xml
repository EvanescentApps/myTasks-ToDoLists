        <Button
            android:id="@+id/no_connexion"
            style="@style/StyledButton"
            android:layout_height="54dp"
            android:layout_marginBottom="4dp"
            android:alpha="0.8"
            android:gravity="center"

            android:padding="2dp"
            android:text="@string/later_signin"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="@color/floatingAddButton"
            app:layout_constraintBottom_toTopOf="@id/legal_infos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- android:layout_marginBottom="10dp"-->

        <TextView
            android:id="@+id/legal_infos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tos_confidentiality"
            android:textColorLink="@color/fabText"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/snackBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

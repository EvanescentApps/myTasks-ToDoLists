<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingStart="14dp"
    android:paddingRight="16dp"
    android:paddingEnd="16dp"

    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <!--20 or 26 padingLeft / right ? -->
    <!--20 or 16 padding top and bottom ?-->

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox"
        app:buttonTint="@color/checkbox"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginLeft="6dp"
        android:gravity="center"
        android:alpha="0.7"
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:theme="@style/checkbox"

        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:paddingLeft="24dp"

        android:paddingStart="24dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:maxLines="3"
            android:text="Préparer la version Release"
            app:fontFamily="@font/lexend_semibold"
            android:ellipsize="end"
            android:textColor="@color/textContentPrimary"
            android:textSize="18sp" />

        <!--android:alpha="0.6"-->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:fontFamily="@font/lexend_semibold"
            android:ellipsize="end"
            android:textColor="@color/textContentSecondary"
            android:text="Traquer les bugs, vérifier la compatibilité, et les fonctionnalités"/>

    </LinearLayout>




</LinearLayout>